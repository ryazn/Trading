//@version=5
strategy("PHANTOM STRATEGY", overlay=true, max_bars_back=5000, max_lines_count=100,
     initial_capital=100000, default_qty_type=strategy.fixed,
     default_qty_value=1, commission_type=strategy.commission.cash_per_contract,
     commission_value=1.24, slippage=1, pyramiding=0,
     process_orders_on_close=false, calc_on_every_tick=false,
     currency=currency.USD)

// ========================================
// PHANTOM CVD Divergence Strategy v2.0
// Optimized via 5-year sensitivity analysis (2021-2025)
//
// Key finding: min_strength=0.6 is the single most impactful parameter.
// It filters out ~75% of weak CVD divergences, keeping only high-conviction signals.
//
// 5-Year Results (Config B):
//   Net P&L:  +$10,875 (+10.87%)
//   Trades:   228 (46/year)
//   Win Rate: 46.1%
//   PF:       1.28
//   Max DD:   6.96%
//   Sharpe:   0.23
//
// Removed inputs with no/negative impact:
//   - CVD smoothing (smoothing hurt — raw CVD is best)
//   - CVD momentum filter (hurt when combined with strength filter)
//   - Trailing stop, break-even, max hold time
//   - Max drawdown / daily loss limit stops
//   - Multiple SL modes (ATR is the winner)
//   - Multiple TP modes (Risk:Reward is the winner)
//   - Multiple position sizing modes (Fixed Contracts is cleanest)
//   - Custom CVD timeframe
// ========================================

// ========== STRATEGY DIRECTION ==========
trade_direction = input.string("Both", "Trade Direction", options=["Long Only", "Short Only", "Both"], group="Strategy Settings")
allow_longs = trade_direction == "Long Only" or trade_direction == "Both"
allow_shorts = trade_direction == "Short Only" or trade_direction == "Both"

// ========== RISK MANAGEMENT ==========
// --- Position Sizing (Fixed Contracts) ---
fixed_qty = input.int(1, "Contracts", minval=1, maxval=1000, group="Position Sizing")

// --- Stop Loss (ATR) ---
use_stop_loss = input.bool(true, "Enable Stop Loss", group="Stop Loss")
sl_atr_mult = input.float(2.5, "SL ATR Multiplier", minval=0.5, maxval=10.0, step=0.25, group="Stop Loss")
sl_atr_period = input.int(14, "SL ATR Period", minval=5, maxval=50, group="Stop Loss")

// --- Take Profit (Risk:Reward) ---
use_take_profit = input.bool(true, "Enable Take Profit", group="Take Profit")
tp_rr_ratio = input.float(1.5, "Risk:Reward Ratio", minval=0.5, maxval=10.0, step=0.25, group="Take Profit", tooltip="TP = SL distance * this ratio")

// --- Session Filter ---
use_session_filter = input.bool(true, "Enable Session Filter", group="Session Filter")
session_start = input.session("0930-1600", "Trading Session", group="Session Filter", tooltip="Only trade during this session (exchange timezone)")
close_at_session_end = input.bool(true, "Close Positions at Session End", group="Session Filter")

// ========== SWING DETECTION ==========
pivot_left = input.int(10, "Pivot Left Bars", minval=2, maxval=50, group="Swing Detection")
pivot_right = input.int(1, "Pivot Right Bars", minval=1, maxval=10, group="Swing Detection")
max_level_age = input.int(100, "Max Swing Level Age (bars)", minval=20, maxval=1000, group="Swing Detection")

// ========== SWEEP DETECTION ==========
sweep_ticks = input.int(2, "Sweep Threshold (ticks past level)", minval=1, maxval=10, group="Sweep Detection")

// ========== STRENGTH FILTER ==========
min_strength = input.float(0.6, "Min Divergence Strength", minval=0.0, maxval=1.0, step=0.05, group="Strength Filter", tooltip="0.6 filters out ~75% of weak signals. THE key parameter.")
strength_period = input.int(100, "Strength Lookback Period", minval=10, maxval=500, group="Strength Filter")

// ========== SIGNAL CONTROL ==========
signal_cooldown = input.int(5, "Signal Cooldown (bars)", minval=0, maxval=50, group="Signal Control")

// ========== VISUAL SETTINGS ==========
show_swept_lines = input.bool(true, "Show Swept Level Lines", group="Visual")
line_extend_bars = input.int(8, "Line Extension (bars past signal)", minval=2, maxval=30, group="Visual")
show_debug = input.bool(false, "Show Debug Labels", group="Visual")
bull_color = input.color(color.green, "Bullish Signal", group="Visual")
bear_color = input.color(color.red, "Bearish Signal", group="Visual")
level_line_color = input.color(color.new(#3179f5, 50), "Swept Level Line Color", group="Visual")

// ========== CVD CALCULATION ==========
// Raw CVD (no smoothing — sensitivity analysis confirmed smoothing hurts)
// Anchored to 1D (anchor period had zero impact on results)
upAndDownVolume() =>
    posVol = 0.0
    negVol = 0.0
    var isBuyVolume = true
    switch
        close > open     => isBuyVolume := true
        close < open     => isBuyVolume := false
        close > close[1] => isBuyVolume := true
        close < close[1] => isBuyVolume := false
    if isBuyVolume
        posVol += volume
    else
        negVol -= volume
    posVol + negVol

var lowerTimeframe = switch
    timeframe.isseconds => "1S"
    timeframe.isintraday => "1"
    timeframe.isdaily   => "5"
    => "60"

diffVolArray = request.security_lower_tf(syminfo.tickerid, lowerTimeframe, upAndDownVolume())

getHighLow(arr) =>
    float cumVolume = na
    float maxVolume = na
    float minVolume = na
    for item in arr
        cumVolume := nz(cumVolume) + item
        maxVolume := math.max(nz(maxVolume), cumVolume)
        minVolume := math.min(nz(minVolume), cumVolume)
    [maxVolume, minVolume, cumVolume]

[maxVolume, minVolume, lastVolume] = getHighLow(diffVolArray)

var cumulLastVolume = 0.0
anchorChange = timeframe.change("1D") or (not na(lastVolume) and na(lastVolume[1]))
cumulOpenVolume = anchorChange ? 0.0 : cumulLastVolume[1]
cumulLastVolume := cumulOpenVolume + lastVolume
cvd = cumulLastVolume

// ========== STRENGTH CALCULATION ==========
cvd_highest = ta.highest(cvd, strength_period)
cvd_lowest = ta.lowest(cvd, strength_period)
cvd_range = math.max(cvd_highest - cvd_lowest, 1.0)

// ========== ATR FOR RISK MANAGEMENT ==========
atr_val = ta.atr(sl_atr_period)

// ========== SWEEP THRESHOLD ==========
sweep_threshold = sweep_ticks * syminfo.mintick

// ========== SWING LEVEL TRACKING ==========
price_pivot_high = ta.pivothigh(high, pivot_left, pivot_right)
price_pivot_low = ta.pivotlow(low, pivot_left, pivot_right)

var array<float> swing_hi_price = array.new<float>(0)
var array<float> swing_hi_cvd = array.new<float>(0)
var array<int> swing_hi_bar = array.new<int>(0)

var array<float> swing_lo_price = array.new<float>(0)
var array<float> swing_lo_cvd = array.new<float>(0)
var array<int> swing_lo_bar = array.new<int>(0)

if not na(price_pivot_high)
    array.push(swing_hi_price, price_pivot_high)
    array.push(swing_hi_cvd, cvd[pivot_right])
    array.push(swing_hi_bar, bar_index - pivot_right)

if not na(price_pivot_low)
    array.push(swing_lo_price, price_pivot_low)
    array.push(swing_lo_cvd, cvd[pivot_right])
    array.push(swing_lo_bar, bar_index - pivot_right)

// ========== PRUNE OLD LEVELS ==========
if array.size(swing_hi_price) > 0
    for i = array.size(swing_hi_price) - 1 to 0
        if (bar_index - array.get(swing_hi_bar, i)) > max_level_age
            array.remove(swing_hi_price, i)
            array.remove(swing_hi_cvd, i)
            array.remove(swing_hi_bar, i)

if array.size(swing_lo_price) > 0
    for i = array.size(swing_lo_price) - 1 to 0
        if (bar_index - array.get(swing_lo_bar, i)) > max_level_age
            array.remove(swing_lo_price, i)
            array.remove(swing_lo_cvd, i)
            array.remove(swing_lo_bar, i)

while array.size(swing_hi_price) > 30
    array.shift(swing_hi_price)
    array.shift(swing_hi_cvd)
    array.shift(swing_hi_bar)

while array.size(swing_lo_price) > 30
    array.shift(swing_lo_price)
    array.shift(swing_lo_cvd)
    array.shift(swing_lo_bar)

// ========== LIQUIDITY SWEEP + DIVERGENCE DETECTION ==========
var int last_bear_bar = -9999
var int last_bull_bar = -9999

bearish_divergence = false
bullish_divergence = false

var float bear_strength_out = 0.0
var float bull_strength_out = 0.0
var float bear_dbg_price = na
var float bear_dbg_cvd = na
var float bear_dbg_swept_price = na
var int bear_swept_origin_bar = na

var float bull_dbg_price = na
var float bull_dbg_cvd = na
var float bull_dbg_swept_price = na
var int bull_swept_origin_bar = na

// --- BEARISH: Price sweeps above a prior swing high, CVD lower ---
if array.size(swing_hi_price) > 0
    array<int> consumed = array.new<int>(0)
    float best_strength = 0.0
    bool found = false
    float f_swept_price = na
    float f_swept_cvd = na
    int f_swept_bar = na

    for i = 0 to array.size(swing_hi_price) - 1
        sh_price = array.get(swing_hi_price, i)
        sh_cvd = array.get(swing_hi_cvd, i)
        sh_bar = array.get(swing_hi_bar, i)

        if high > sh_price + sweep_threshold
            array.push(consumed, i)

            if cvd < sh_cvd
                div_magnitude = math.abs(cvd - sh_cvd)
                this_strength = math.min(div_magnitude / cvd_range, 1.0)

                if this_strength > best_strength
                    best_strength := this_strength
                    found := true
                    f_swept_price := sh_price
                    f_swept_cvd := sh_cvd
                    f_swept_bar := sh_bar

    if array.size(consumed) > 0
        for i = array.size(consumed) - 1 to 0
            idx = array.get(consumed, i)
            array.remove(swing_hi_price, idx)
            array.remove(swing_hi_cvd, idx)
            array.remove(swing_hi_bar, idx)

    if found and best_strength >= min_strength and (bar_index - last_bear_bar) >= signal_cooldown
        bearish_divergence := true
        bear_strength_out := best_strength
        bear_dbg_price := high
        bear_dbg_cvd := cvd
        bear_dbg_swept_price := f_swept_price
        bear_swept_origin_bar := f_swept_bar
        last_bear_bar := bar_index

// --- BULLISH: Price sweeps below a prior swing low, CVD higher ---
if array.size(swing_lo_price) > 0
    array<int> consumed = array.new<int>(0)
    float best_strength = 0.0
    bool found = false
    float f_swept_price = na
    float f_swept_cvd = na
    int f_swept_bar = na

    for i = 0 to array.size(swing_lo_price) - 1
        sl_price = array.get(swing_lo_price, i)
        sl_cvd = array.get(swing_lo_cvd, i)
        sl_bar = array.get(swing_lo_bar, i)

        if low < sl_price - sweep_threshold
            array.push(consumed, i)

            if cvd > sl_cvd
                div_magnitude = math.abs(cvd - sl_cvd)
                this_strength = math.min(div_magnitude / cvd_range, 1.0)

                if this_strength > best_strength
                    best_strength := this_strength
                    found := true
                    f_swept_price := sl_price
                    f_swept_cvd := sl_cvd
                    f_swept_bar := sl_bar

    if array.size(consumed) > 0
        for i = array.size(consumed) - 1 to 0
            idx = array.get(consumed, i)
            array.remove(swing_lo_price, idx)
            array.remove(swing_lo_cvd, idx)
            array.remove(swing_lo_bar, idx)

    if found and best_strength >= min_strength and (bar_index - last_bull_bar) >= signal_cooldown
        bullish_divergence := true
        bull_strength_out := best_strength
        bull_dbg_price := low
        bull_dbg_cvd := cvd
        bull_dbg_swept_price := f_swept_price
        bull_swept_origin_bar := f_swept_bar
        last_bull_bar := bar_index

// ========== SESSION FILTER ==========
in_session = use_session_filter ? not na(time(timeframe.period, session_start)) : true

// ========== STOP LOSS & TAKE PROFIT DISTANCES ==========
sl_distance = use_stop_loss ? atr_val * sl_atr_mult : na
tp_distance = use_take_profit and not na(sl_distance) ? sl_distance * tp_rr_ratio : na

// ========== ENTRY LOGIC ==========
can_trade = in_session

// --- LONG ENTRY ---
if bullish_divergence and allow_longs and can_trade and strategy.position_size <= 0
    if strategy.position_size < 0
        strategy.close("Short", comment="Close Short → Long")

    float sl_price = na
    float tp_price = na
    if use_stop_loss and not na(sl_distance)
        sl_price := close - sl_distance
    if use_take_profit and not na(tp_distance)
        tp_price := close + tp_distance

    strategy.entry("Long", strategy.long, qty=fixed_qty)

    if use_stop_loss and not na(sl_price)
        strategy.exit("Long Exit", "Long", stop=sl_price, limit=use_take_profit ? tp_price : na)
    else if use_take_profit and not na(tp_price)
        strategy.exit("Long Exit", "Long", limit=tp_price)

// --- SHORT ENTRY ---
if bearish_divergence and allow_shorts and can_trade and strategy.position_size >= 0
    if strategy.position_size > 0
        strategy.close("Long", comment="Close Long → Short")

    float sl_price = na
    float tp_price = na
    if use_stop_loss and not na(sl_distance)
        sl_price := close + sl_distance
    if use_take_profit and not na(tp_distance)
        tp_price := close - tp_distance

    strategy.entry("Short", strategy.short, qty=fixed_qty)

    if use_stop_loss and not na(sl_price)
        strategy.exit("Short Exit", "Short", stop=sl_price, limit=use_take_profit ? tp_price : na)
    else if use_take_profit and not na(tp_price)
        strategy.exit("Short Exit", "Short", limit=tp_price)

// ========== SESSION CLOSE EXIT ==========
if close_at_session_end and use_session_filter
    if not in_session and in_session[1]
        if strategy.position_size > 0
            strategy.close("Long", comment="Session Close")
        if strategy.position_size < 0
            strategy.close("Short", comment="Session Close")

// ========== PLOTTING ==========
plotshape(bullish_divergence and allow_longs and can_trade, "Bullish Entry", shape.triangleup, location.belowbar, bull_color, size=size.normal, text="LONG")
plotshape(bearish_divergence and allow_shorts and can_trade, "Bearish Entry", shape.triangledown, location.abovebar, bear_color, size=size.normal, text="SHORT")

// Swept level lines
if show_swept_lines and bearish_divergence and not na(bear_swept_origin_bar)
    line.new(bear_swept_origin_bar, bear_dbg_swept_price, bar_index + line_extend_bars, bear_dbg_swept_price, color=level_line_color, width=2, style=line.style_solid)
if show_swept_lines and bullish_divergence and not na(bull_swept_origin_bar)
    line.new(bull_swept_origin_bar, bull_dbg_swept_price, bar_index + line_extend_bars, bull_dbg_swept_price, color=level_line_color, width=2, style=line.style_solid)

// Debug labels
if show_debug and bearish_divergence
    label.new(bar_index, bear_dbg_swept_price, "Sweep: " + str.tostring(bear_dbg_price, "#.##") + "\nLevel: " + str.tostring(bear_dbg_swept_price, "#.##") + "\nCVD: " + str.tostring(bear_dbg_cvd, "#") + "\nStr: " + str.tostring(bear_strength_out, "#.##"), color=bear_color, textcolor=color.white, size=size.small, style=label.style_label_down)
if show_debug and bullish_divergence
    label.new(bar_index, bull_dbg_swept_price, "Sweep: " + str.tostring(bull_dbg_price, "#.##") + "\nLevel: " + str.tostring(bull_dbg_swept_price, "#.##") + "\nCVD: " + str.tostring(bull_dbg_cvd, "#") + "\nStr: " + str.tostring(bull_strength_out, "#.##"), color=bull_color, textcolor=color.white, size=size.small, style=label.style_label_up)

// Background
bear_bg_alpha = bearish_divergence ? math.round(90 - bear_strength_out * 30) : 100
bull_bg_alpha = bullish_divergence ? math.round(90 - bull_strength_out * 30) : 100
bgcolor(bearish_divergence ? color.new(bear_color, bear_bg_alpha) : na)
bgcolor(bullish_divergence ? color.new(bull_color, bull_bg_alpha) : na)

// ========== STRATEGY INFO TABLE ==========
var table info_table = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(info_table, 0, 0, "PHANTOM v2.0", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 0, "Optimized", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 0, 1, "Net P&L", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 1, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? color.green : color.red, text_size=size.tiny)
    table.cell(info_table, 0, 2, "Win Rate", text_color=color.gray, text_size=size.tiny)
    wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    table.cell(info_table, 1, 2, str.tostring(wr, "#.#") + "%", text_color=wr >= 50 ? color.green : color.orange, text_size=size.tiny)
    table.cell(info_table, 0, 3, "Trades", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 3, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.tiny)
    table.cell(info_table, 0, 4, "Profit Factor", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 4, str.tostring(strategy.grossprofit / math.max(math.abs(strategy.grossloss), 1), "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(info_table, 0, 5, "Max DD", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 5, str.tostring(strategy.max_drawdown, "#.##"), text_color=color.red, text_size=size.tiny)
    table.cell(info_table, 0, 6, "Strength", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 6, str.tostring(min_strength, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(info_table, 0, 7, "Direction", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 7, trade_direction, text_color=color.white, text_size=size.tiny)

// ========== ALERTS ==========
alertcondition(bearish_divergence, "Bearish Signal", "PHANTOM: Short entry signal!")
alertcondition(bullish_divergence, "Bullish Signal", "PHANTOM: Long entry signal!")
alertcondition(bearish_divergence or bullish_divergence, "Any Signal", "PHANTOM: Trade signal!")
