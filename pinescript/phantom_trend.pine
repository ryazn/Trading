//@version=5
strategy("PHANTOM TREND", overlay=true, max_bars_back=5000, max_lines_count=100,
     initial_capital=100000, default_qty_type=strategy.fixed,
     default_qty_value=1, commission_type=strategy.commission.cash_per_contract,
     commission_value=1.24, slippage=1, pyramiding=0,
     process_orders_on_close=false, calc_on_every_tick=false,
     currency=currency.USD)

// ========================================
// PHANTOM TREND Strategy v1.0
// Liquidity Sweep + SMA Trend Continuation
//
// Core concept: Use pivot-based liquidity sweeps as pullback entries
// in the direction of the prevailing trend (defined by SMA slope).
//
//   SMA trending UP  + sweep of lows  → LONG  (buy the dip)
//   SMA trending DOWN + sweep of highs → SHORT (sell the rip)
//
// No CVD/divergence needed — the sweep IS the signal,
// the SMA trend IS the filter.
//
// This is a trend-following strategy, not mean-reversion.
// Expects higher win rate but needs trending markets.
// ========================================

// ========== STRATEGY DIRECTION ==========
trade_direction = input.string("Both", "Trade Direction", options=["Long Only", "Short Only", "Both"], group="Strategy Settings")
allow_longs = trade_direction == "Long Only" or trade_direction == "Both"
allow_shorts = trade_direction == "Short Only" or trade_direction == "Both"

// ========== RISK MANAGEMENT ==========
fixed_qty = input.int(1, "Contracts", minval=1, maxval=1000, group="Position Sizing")

use_stop_loss = input.bool(true, "Enable Stop Loss", group="Stop Loss")
sl_atr_mult = input.float(2.5, "SL ATR Multiplier", minval=0.5, maxval=10.0, step=0.25, group="Stop Loss")
sl_atr_period = input.int(14, "SL ATR Period", minval=5, maxval=50, group="Stop Loss")

use_take_profit = input.bool(true, "Enable Take Profit", group="Take Profit")
tp_rr_ratio = input.float(1.5, "Risk:Reward Ratio", minval=0.5, maxval=10.0, step=0.25, group="Take Profit", tooltip="TP = SL distance * this ratio")

use_session_filter = input.bool(true, "Enable Session Filter", group="Session Filter")
session_start = input.session("0930-1600", "Trading Session", group="Session Filter", tooltip="Only trade during this session (exchange timezone)")
close_at_session_end = input.bool(true, "Close Positions at Session End", group="Session Filter")

// ========== SMA TREND FILTER ==========
sma_length = input.int(35, "SMA Length", minval=5, maxval=200, group="Trend Filter", tooltip="SMA period for trend direction. 35 is a good balance between responsiveness and noise filtering.")
sma_type = input.string("SMA", "Moving Average Type", options=["SMA", "EMA", "WMA", "VWMA"], group="Trend Filter", tooltip="Type of moving average to use")
trend_lookback = input.int(5, "Trend Slope Lookback (bars)", minval=1, maxval=50, group="Trend Filter", tooltip="Compare current SMA to N bars ago to determine trend direction")
require_price_side = input.bool(true, "Require Price on Trend Side", group="Trend Filter", tooltip="For longs: price must be above SMA. For shorts: price must be below SMA.")

// ========== SWING DETECTION ==========
pivot_left = input.int(10, "Pivot Left Bars", minval=2, maxval=50, group="Swing Detection")
pivot_right = input.int(1, "Pivot Right Bars", minval=1, maxval=10, group="Swing Detection")
max_level_age = input.int(100, "Max Swing Level Age (bars)", minval=20, maxval=1000, group="Swing Detection")

// ========== SWEEP DETECTION ==========
sweep_ticks = input.int(2, "Min Sweep (ticks past level)", minval=1, maxval=10, group="Sweep Detection")

// ========== SWEEP QUALITY FILTERS ==========
use_rejection = input.bool(true, "Require Sweep Rejection", group="Sweep Quality", tooltip="Sweep bar must close back past the level — wick through, not breakout.")
max_sweep_ticks = input.int(8, "Max Sweep Distance (ticks)", minval=2, maxval=50, group="Sweep Quality", tooltip="Reject sweeps that penetrate too far (likely breakouts)")
use_approach = input.bool(true, "Require Approach Momentum", group="Sweep Quality", tooltip="Price must have moved toward the level before the sweep")
approach_bars = input.int(5, "Approach Lookback (bars)", minval=2, maxval=20, group="Sweep Quality")
approach_min_atr = input.float(0.5, "Min Approach Move (ATR mult)", minval=0.1, maxval=3.0, step=0.1, group="Sweep Quality")

// ========== SIGNAL CONTROL ==========
signal_cooldown = input.int(5, "Signal Cooldown (bars)", minval=0, maxval=50, group="Signal Control")

// ========== VISUAL SETTINGS ==========
show_sma = input.bool(true, "Show SMA Line", group="Visual")
show_swept_lines = input.bool(true, "Show Swept Level Lines", group="Visual")
line_extend_bars = input.int(8, "Line Extension (bars past signal)", minval=2, maxval=30, group="Visual")
show_debug = input.bool(false, "Show Debug Labels", group="Visual")
bull_color = input.color(color.green, "Bullish Signal", group="Visual")
bear_color = input.color(color.red, "Bearish Signal", group="Visual")
sma_up_color = input.color(color.new(color.green, 30), "SMA Uptrend", group="Visual")
sma_down_color = input.color(color.new(color.red, 30), "SMA Downtrend", group="Visual")
sma_flat_color = input.color(color.new(color.gray, 50), "SMA Flat", group="Visual")
level_line_color = input.color(color.new(#3179f5, 50), "Swept Level Line Color", group="Visual")

// ========== SMA CALCULATION ==========
ma_val = switch sma_type
    "SMA"  => ta.sma(close, sma_length)
    "EMA"  => ta.ema(close, sma_length)
    "WMA"  => ta.wma(close, sma_length)
    "VWMA" => ta.vwma(close, sma_length)
    => ta.sma(close, sma_length)

// Trend direction based on slope
sma_slope = ma_val - ma_val[trend_lookback]
trend_up = sma_slope > 0
trend_down = sma_slope < 0

// Price relative to SMA
price_above_sma = close > ma_val
price_below_sma = close < ma_val

// ========== ATR ==========
atr_val = ta.atr(sl_atr_period)

// ========== SWEEP THRESHOLDS ==========
sweep_threshold = sweep_ticks * syminfo.mintick
max_sweep_threshold = max_sweep_ticks * syminfo.mintick

// ========== APPROACH MOMENTUM ==========
// For trend strategy: approach is AGAINST the trend (pullback into the level)
// Longs (sweep of lows): price was moving DOWN into the low (pullback in uptrend)
bull_approach_ok = use_approach ? (close[approach_bars] - low >= approach_min_atr * atr_val) : true
// Shorts (sweep of highs): price was moving UP into the high (rally in downtrend)
bear_approach_ok = use_approach ? (high - close[approach_bars] >= approach_min_atr * atr_val) : true

// ========== SWING LEVEL TRACKING ==========
price_pivot_high = ta.pivothigh(high, pivot_left, pivot_right)
price_pivot_low = ta.pivotlow(low, pivot_left, pivot_right)

var array<float> swing_hi_price = array.new<float>(0)
var array<int> swing_hi_bar = array.new<int>(0)

var array<float> swing_lo_price = array.new<float>(0)
var array<int> swing_lo_bar = array.new<int>(0)

if not na(price_pivot_high)
    array.push(swing_hi_price, price_pivot_high)
    array.push(swing_hi_bar, bar_index - pivot_right)

if not na(price_pivot_low)
    array.push(swing_lo_price, price_pivot_low)
    array.push(swing_lo_bar, bar_index - pivot_right)

// ========== PRUNE OLD LEVELS ==========
if array.size(swing_hi_price) > 0
    for i = array.size(swing_hi_price) - 1 to 0
        if (bar_index - array.get(swing_hi_bar, i)) > max_level_age
            array.remove(swing_hi_price, i)
            array.remove(swing_hi_bar, i)

if array.size(swing_lo_price) > 0
    for i = array.size(swing_lo_price) - 1 to 0
        if (bar_index - array.get(swing_lo_bar, i)) > max_level_age
            array.remove(swing_lo_price, i)
            array.remove(swing_lo_bar, i)

while array.size(swing_hi_price) > 30
    array.shift(swing_hi_price)
    array.shift(swing_hi_bar)

while array.size(swing_lo_price) > 30
    array.shift(swing_lo_price)
    array.shift(swing_lo_bar)

// ========== LIQUIDITY SWEEP DETECTION ==========
var int last_bear_bar = -9999
var int last_bull_bar = -9999

bear_sweep = false
bull_sweep = false

var float bear_swept_price = na
var int bear_swept_origin_bar = na
var float bull_swept_price = na
var int bull_swept_origin_bar = na

// --- Sweep of HIGHS (potential short in downtrend) ---
if array.size(swing_hi_price) > 0
    array<int> consumed = array.new<int>(0)
    bool found = false
    float f_swept_price = na
    int f_swept_bar = na

    for i = 0 to array.size(swing_hi_price) - 1
        sh_price = array.get(swing_hi_price, i)
        sh_bar = array.get(swing_hi_bar, i)

        if high > sh_price + sweep_threshold
            array.push(consumed, i)

            sweep_dist = high - sh_price
            sweep_ok = sweep_dist <= max_sweep_threshold

            if sweep_ok
                if not found or sh_price > f_swept_price
                    found := true
                    f_swept_price := sh_price
                    f_swept_bar := sh_bar

    if array.size(consumed) > 0
        for i = array.size(consumed) - 1 to 0
            idx = array.get(consumed, i)
            array.remove(swing_hi_price, idx)
            array.remove(swing_hi_bar, idx)

    rejection_ok = use_rejection ? (close < f_swept_price) : true

    if found and rejection_ok and bear_approach_ok and (bar_index - last_bear_bar) >= signal_cooldown
        bear_sweep := true
        bear_swept_price := f_swept_price
        bear_swept_origin_bar := f_swept_bar
        last_bear_bar := bar_index

// --- Sweep of LOWS (potential long in uptrend) ---
if array.size(swing_lo_price) > 0
    array<int> consumed = array.new<int>(0)
    bool found = false
    float f_swept_price = na
    int f_swept_bar = na

    for i = 0 to array.size(swing_lo_price) - 1
        sl_price = array.get(swing_lo_price, i)
        sl_bar = array.get(swing_lo_bar, i)

        if low < sl_price - sweep_threshold
            array.push(consumed, i)

            sweep_dist = sl_price - low
            sweep_ok = sweep_dist <= max_sweep_threshold

            if sweep_ok
                if not found or sl_price < f_swept_price
                    found := true
                    f_swept_price := sl_price
                    f_swept_bar := sl_bar

    if array.size(consumed) > 0
        for i = array.size(consumed) - 1 to 0
            idx = array.get(consumed, i)
            array.remove(swing_lo_price, idx)
            array.remove(swing_lo_bar, idx)

    rejection_ok = use_rejection ? (close > f_swept_price) : true

    if found and rejection_ok and bull_approach_ok and (bar_index - last_bull_bar) >= signal_cooldown
        bull_sweep := true
        bull_swept_price := f_swept_price
        bull_swept_origin_bar := f_swept_bar
        last_bull_bar := bar_index

// ========== TREND + SWEEP SIGNAL LOGIC ==========
// LONG: SMA trending up + sweep of lows (buy the dip in an uptrend)
price_ok_long = require_price_side ? price_above_sma : true
long_signal = bull_sweep and trend_up and price_ok_long

// SHORT: SMA trending down + sweep of highs (sell the rip in a downtrend)
price_ok_short = require_price_side ? price_below_sma : true
short_signal = bear_sweep and trend_down and price_ok_short

// ========== SESSION FILTER ==========
in_session = use_session_filter ? not na(time(timeframe.period, session_start)) : true

// ========== STOP LOSS & TAKE PROFIT ==========
sl_distance = use_stop_loss ? atr_val * sl_atr_mult : na
tp_distance = use_take_profit and not na(sl_distance) ? sl_distance * tp_rr_ratio : na

// ========== ENTRY LOGIC ==========
can_trade = in_session

// --- LONG ENTRY ---
if long_signal and allow_longs and can_trade and strategy.position_size <= 0
    if strategy.position_size < 0
        strategy.close("Short", comment="Close Short → Long")

    float sl_price = na
    float tp_price = na
    if use_stop_loss and not na(sl_distance)
        sl_price := close - sl_distance
    if use_take_profit and not na(tp_distance)
        tp_price := close + tp_distance

    strategy.entry("Long", strategy.long, qty=fixed_qty)

    if use_stop_loss and not na(sl_price)
        strategy.exit("Long Exit", "Long", stop=sl_price, limit=use_take_profit ? tp_price : na)
    else if use_take_profit and not na(tp_price)
        strategy.exit("Long Exit", "Long", limit=tp_price)

// --- SHORT ENTRY ---
if short_signal and allow_shorts and can_trade and strategy.position_size >= 0
    if strategy.position_size > 0
        strategy.close("Long", comment="Close Long → Short")

    float sl_price = na
    float tp_price = na
    if use_stop_loss and not na(sl_distance)
        sl_price := close + sl_distance
    if use_take_profit and not na(tp_distance)
        tp_price := close - tp_distance

    strategy.entry("Short", strategy.short, qty=fixed_qty)

    if use_stop_loss and not na(sl_price)
        strategy.exit("Short Exit", "Short", stop=sl_price, limit=use_take_profit ? tp_price : na)
    else if use_take_profit and not na(tp_price)
        strategy.exit("Short Exit", "Short", limit=tp_price)

// ========== SESSION CLOSE EXIT ==========
if close_at_session_end and use_session_filter
    if not in_session and in_session[1]
        if strategy.position_size > 0
            strategy.close("Long", comment="Session Close")
        if strategy.position_size < 0
            strategy.close("Short", comment="Session Close")

// ========== PLOTTING ==========
// SMA line colored by trend direction
sma_color = trend_up ? sma_up_color : trend_down ? sma_down_color : sma_flat_color
plot(show_sma ? ma_val : na, "SMA", color=sma_color, linewidth=2)

// Entry signals
plotshape(long_signal and allow_longs and can_trade, "Long Entry", shape.triangleup, location.belowbar, bull_color, size=size.normal, text="LONG")
plotshape(short_signal and allow_shorts and can_trade, "Short Entry", shape.triangledown, location.abovebar, bear_color, size=size.normal, text="SHORT")

// Swept level lines
if show_swept_lines and short_signal and not na(bear_swept_origin_bar)
    line.new(bear_swept_origin_bar, bear_swept_price, bar_index + line_extend_bars, bear_swept_price, color=level_line_color, width=2, style=line.style_solid)
if show_swept_lines and long_signal and not na(bull_swept_origin_bar)
    line.new(bull_swept_origin_bar, bull_swept_price, bar_index + line_extend_bars, bull_swept_price, color=level_line_color, width=2, style=line.style_solid)

// Debug labels
if show_debug and long_signal
    label.new(bar_index, bull_swept_price, "TREND LONG\nSweep: " + str.tostring(low, "#.##") + "\nLevel: " + str.tostring(bull_swept_price, "#.##") + "\nSMA: " + str.tostring(ma_val, "#.##") + "\nSlope: " + str.tostring(sma_slope, "#.##"), color=bull_color, textcolor=color.white, size=size.small, style=label.style_label_up)
if show_debug and short_signal
    label.new(bar_index, bear_swept_price, "TREND SHORT\nSweep: " + str.tostring(high, "#.##") + "\nLevel: " + str.tostring(bear_swept_price, "#.##") + "\nSMA: " + str.tostring(ma_val, "#.##") + "\nSlope: " + str.tostring(sma_slope, "#.##"), color=bear_color, textcolor=color.white, size=size.small, style=label.style_label_down)

// Background
bgcolor(long_signal and can_trade ? color.new(bull_color, 90) : na)
bgcolor(short_signal and can_trade ? color.new(bear_color, 90) : na)

// ========== STRATEGY INFO TABLE ==========
var table info_table = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(info_table, 0, 0, "PHANTOM TREND", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 0, "v1.0", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 0, 1, "Net P&L", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 1, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? color.green : color.red, text_size=size.tiny)
    table.cell(info_table, 0, 2, "Win Rate", text_color=color.gray, text_size=size.tiny)
    wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    table.cell(info_table, 1, 2, str.tostring(wr, "#.#") + "%", text_color=wr >= 50 ? color.green : color.orange, text_size=size.tiny)
    table.cell(info_table, 0, 3, "Trades", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 3, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.tiny)
    table.cell(info_table, 0, 4, "Profit Factor", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 4, str.tostring(strategy.grossprofit / math.max(math.abs(strategy.grossloss), 1), "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(info_table, 0, 5, "Max DD", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 5, str.tostring(strategy.max_drawdown, "#.##"), text_color=color.red, text_size=size.tiny)
    table.cell(info_table, 0, 6, sma_type + " " + str.tostring(sma_length), text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 6, str.tostring(ma_val, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(info_table, 0, 7, "Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 7, trend_up ? "▲ UP" : trend_down ? "▼ DOWN" : "— FLAT", text_color=trend_up ? color.green : trend_down ? color.red : color.gray, text_size=size.tiny)
    table.cell(info_table, 0, 8, "Rejection", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 8, use_rejection ? "ON" : "OFF", text_color=use_rejection ? color.green : color.gray, text_size=size.tiny)
    table.cell(info_table, 0, 9, "Direction", text_color=color.gray, text_size=size.tiny)
    table.cell(info_table, 1, 9, trade_direction, text_color=color.white, text_size=size.tiny)

// ========== ALERTS ==========
alertcondition(short_signal, "Trend Short", "PHANTOM TREND: Short entry — sweep of highs in downtrend!")
alertcondition(long_signal, "Trend Long", "PHANTOM TREND: Long entry — sweep of lows in uptrend!")
alertcondition(short_signal or long_signal, "Any Signal", "PHANTOM TREND: Trade signal!")
